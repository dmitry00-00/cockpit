#!/bin/zsh
# Открыть стол: доустанавливает, что изменилось (setup.command --start), и открывает http://localhost:5180 в браузере.
# Стол работает, пока открыто окно Terminal. Флаги: --lan — отдать стол и в локальную сеть (планшет, второй
# экран); --dev — сервер разработки с горячей заменой вместо собранного dist/; --update — сначала свежий код.
exec zsh "$(dirname "$0")/setup.command" --start "$@"
