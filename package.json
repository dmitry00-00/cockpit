{
  "name": "dm-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Электронная ширма мастера D&D 5e: операционная система живого мира",
  "scripts": {
    "dev": "npm run build:theme && npm run build:icons && vite",
    "build": "npm run build:theme && npm run build:icons && tsc -b --force && vite build",
    "preview": "vite preview",
    "build:theme": "node scripts/build-theme.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test": "npm run build:theme && npm run build:icons && vitest run",
    "check": "tsc -b --force --noEmit"
  },
  "dependencies": {
    "@fontsource/forum": "^5",
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/press-start-2p": "^5",
    "@fontsource/pt-sans": "^5",
    "immer": "^11.1.18",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^26",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3"
  }
}
