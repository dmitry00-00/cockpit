{
  "name": "dm-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Электронная ширма мастера D&D 5e: операционная система живого мира",
  "scripts": {
    "dev": "npm run build:theme && npm run build:icons && npm run build:art && vite",
    "build": "npm run build:theme && npm run build:icons && npm run build:art && npm run check:packages && tsc -b --force && vite build --manifest && npm run build:player-shell && npm run check:art-delivery",
    "preview": "vite preview",
    "build:theme": "node scripts/build-theme.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test": "npm run build:theme && npm run build:icons && npm run build:art && vitest run",
    "check:packages": "node scripts/check-packages.mjs",
    "import:srd": "node scripts/import-srd.mjs",
    "check": "npm run check:packages && tsc -b --force --noEmit",
    "build:art": "node scripts/build-art.mjs",
    "check:art-delivery": "node scripts/check-art-delivery.mjs",
    "build:player-shell": "node scripts/build-player-shell.mjs",
    "test:player-transport": "node --test scripts/player-relay.node-test.mjs",
    "check:art-generation": "node scripts/check-art-generation.mjs",
    "check:chronology-classification": "python3 scripts/apply-chronology-classification.py",
    "build:chronology-classification": "python3 scripts/apply-chronology-classification.py --apply"
  },
  "dependencies": {
    "@fontsource/forum": "^5",
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/press-start-2p": "^5",
    "@fontsource/pt-sans": "^5",
    "immer": "^11.1.18",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^26",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3"
  }
}
